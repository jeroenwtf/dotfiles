theme = TokyoNight
font-family = JetBrains Mono NL
font-size = 12
unfocused-split-opacity = 0.4

keybind = shift+enter=text:\x1b[13;2u
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+|=new_split:down
keybind = ctrl+shift+n=toggle_fullscreen
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right